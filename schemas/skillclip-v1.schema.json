{
  "$id": "https://show-protocol.dev/schemas/skillclip-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SHOW SkillClip Sidecar v1",
  "description": "SkillClip metadata pinned on Tack/IPFS. Hash committed on-chain before mint. v1.0 = human video prompt. v1.1 adds training_mode, embodiment, and optional contributor.kind (human|agent|joint).",
  "type": "object",
  "required": [
    "type",
    "sidecar_version",
    "skill_id",
    "skill_level",
    "content_hash",
    "sidecar_hash",
    "consent"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "https://show.protocol/skillclip-v1"
    },
    "sidecar_version": {
      "type": "string",
      "pattern": "^1\\.(0|1)\\.0$"
    },
    "training_mode": {
      "type": "string",
      "enum": ["prompt", "trajectory", "policy", "recipe"],
      "description": "How the robot consumes this clip. Omitted = prompt (v1.0)."
    },
    "embodiment": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)*\\.v[0-9]+$",
      "description": "Body this skill is valid for, e.g. human.hands.v1 or pollen.microduck.v1"
    },
    "payload": {
      "type": "object",
      "description": "Primary bytes when training_mode is not prompt. Prompt still uses video_cid.",
      "properties": {
        "primary_cid": { "type": "string", "minLength": 10 },
        "format": {
          "type": "string",
          "enum": ["mp4", "rlds", "onnx", "safetensors", "mjlab_recipe", "json"]
        },
        "control_hz": { "type": "number" },
        "sim_engine": { "type": "string" },
        "preview_video_cid": { "type": ["string", "null"] }
      }
    },
    "hub_publish": {
      "type": "object",
      "description": "Optional — same artifact also on Hugging Face Hub; SHOW is the license layer",
      "properties": {
        "also_on": {
          "type": "array",
          "items": { "enum": ["huggingface", "other"] }
        },
        "repo_id": { "type": "string", "maxLength": 256 },
        "creator_certifies_rights": { "type": "boolean", "const": true }
      },
      "required": ["creator_certifies_rights"]
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+\\.v[0-9]+$",
      "description": "e.g. grasp.object.power.v1"
    },
    "skill_level": {
      "type": "string",
      "enum": ["primitive", "micro", "composite"]
    },
    "capture_tier": {
      "type": "string",
      "enum": ["A", "B", "C"]
    },
    "duration_sec": {
      "type": "number",
      "minimum": 3,
      "maximum": 600
    },
    "video_cid": {
      "type": "string",
      "minLength": 10,
      "description": "Tack or IPFS CID of video bytes"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$",
      "description": "keccak256 of raw video file"
    },
    "sidecar_hash": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$",
      "description": "keccak256 of canonical JSON (excluding this field)"
    },
    "creator_address": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "contributor": {
      "type": "object",
      "description": "Who produced this SkillClip. Humans and agents use the same sidecar.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["human", "agent", "joint"],
          "description": "human = filmer/trainer; agent = bot that produced the payload; joint = human-operated agent"
        },
        "id": {
          "type": "string",
          "maxLength": 256,
          "description": "GitHub handle, Moltbook agent name, or other public id"
        },
        "operator": {
          "type": "string",
          "maxLength": 256,
          "description": "Human operator if kind is agent or joint"
        }
      },
      "required": ["kind"]
    },
    "donate": {
      "type": "object",
      "description": "Optional thanks in USDC. Does not grant a license.",
      "properties": {
        "enabled": { "type": "boolean" },
        "currency": { "type": "string", "const": "USDC" },
        "address": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "description": "Payee; omit to use creator_address"
        },
        "chain_id": { "type": "integer" },
        "note": { "type": "string", "maxLength": 280 }
      },
      "required": ["enabled"]
    },
    "chain_id": {
      "type": "integer",
      "const": 167013
    },
    "objects": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "environment_class": {
      "type": "string",
      "enum": [
        "home_kitchen",
        "commercial_kitchen",
        "hotel_room",
        "warehouse",
        "lab_bench",
        "desk",
        "classroom",
        "sim",
        "outdoor",
        "other"
      ]
    },
    "lighting": {
      "type": "string",
      "enum": ["indoor_natural", "indoor_artificial", "mixed", "outdoor"]
    },
    "handedness": {
      "type": "string",
      "enum": ["left", "right", "ambidextrous", "unknown"]
    },
    "primary_angle": {
      "type": "string",
      "enum": [
        "egocentric_chest",
        "egocentric_wrist",
        "top_down",
        "third_person_45",
        "third_person_fixed"
      ]
    },
    "capture": {
      "type": "object",
      "required": ["single_take", "resolution_min", "hands_visible_at_t0"],
      "properties": {
        "single_take": { "type": "boolean", "const": true },
        "resolution_min": { "type": "string", "const": "1080p" },
        "hands_visible_at_t0": { "type": "boolean", "const": true },
        "audio": {
          "type": "string",
          "enum": ["silent", "ambient_only"]
        },
        "device": {
          "type": "string",
          "description": "e.g. smartphone_2021+"
        }
      }
    },
    "consent": {
      "type": "object",
      "required": [
        "commercial_training",
        "residual_participation",
        "signed_at"
      ],
      "properties": {
        "commercial_training": { "type": "boolean", "const": true },
        "residual_participation": { "type": "boolean" },
        "signed_at": { "type": "string", "format": "date-time" }
      }
    },
    "referral": {
      "type": "object",
      "properties": {
        "creator_referrer": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "code": { "type": "string", "maxLength": 64 }
      }
    },
    "lineage": {
      "type": "object",
      "description": "PicBreeder-style branch — optional parent clip in hunt tree",
      "properties": {
        "parent_token_id": {
          "type": ["integer", "null"],
          "description": "On-chain SkillClip token id this variant branches from"
        },
        "variant_tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "e.g. mug, warm_light, home_kitchen"
        },
        "discovery_note": {
          "type": "string",
          "maxLength": 280,
          "description": "Creator hunter note — why this branch"
        }
      }
    },
    "bounty": {
      "type": "object",
      "properties": {
        "sprint": { "type": "string" },
        "usdc_amount": { "type": "number", "minimum": 0 }
      }
    },
    "dual_publish": {
      "type": "object",
      "description": "Optional — creator also uses gig platforms; certifies rights to mint",
      "properties": {
        "also_submitted_to": {
          "type": "array",
          "items": { "enum": ["figure_index", "luel", "huggingface", "other"] }
        },
        "platform_paid": { "type": "boolean" },
        "show_mint_is": {
          "type": "string",
          "enum": ["same_session_atomic", "second_take", "show_only"]
        },
        "creator_certifies_rights": { "type": "boolean", "const": true }
      },
      "required": ["creator_certifies_rights"]
    },
    "optional_modalities": {
      "type": "object",
      "properties": {
        "depth_cid": { "type": ["string", "null"] },
        "imu_cid": { "type": ["string", "null"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "properties": { "sidecar_version": { "const": "1.0.0" } } },
          { "properties": { "training_mode": { "const": "prompt" } } },
          { "not": { "required": ["training_mode"] } }
        ]
      },
      "then": {
        "required": ["video_cid", "capture", "duration_sec", "capture_tier"]
      }
    },
    {
      "if": {
        "allOf": [
          { "properties": { "skill_level": { "const": "primitive" } } },
          {
            "anyOf": [
              { "properties": { "training_mode": { "const": "prompt" } } },
              { "not": { "required": ["training_mode"] } }
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "duration_sec": { "maximum": 20 }
        }
      }
    },
    {
      "if": {
        "properties": { "training_mode": { "const": "policy" } },
        "required": ["training_mode"]
      },
      "then": {
        "required": ["embodiment", "payload", "capture_tier"],
        "properties": {
          "payload": {
            "required": ["primary_cid", "format"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "training_mode": { "const": "recipe" } },
        "required": ["training_mode"]
      },
      "then": {
        "required": ["embodiment", "payload", "capture_tier"],
        "properties": {
          "payload": {
            "required": ["primary_cid", "format"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "training_mode": { "const": "trajectory" } },
        "required": ["training_mode"]
      },
      "then": {
        "required": ["embodiment", "payload", "capture_tier"],
        "properties": {
          "payload": {
            "required": ["primary_cid", "format"]
          }
        }
      }
    }
  ]
}
